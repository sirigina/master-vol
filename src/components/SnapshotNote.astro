---
// Required on every example that uses market data.
import { snapshot } from '../lib/snapshot';
interface Props {
  /** Extra detail, e.g. which expiry the example uses */
  detail?: string;
}
const { detail } = Astro.props;
---

<p class="snap not-content">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
    ><path
      fill="currentColor"
      d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 1.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM7.25 4v4.3l3.1 1.8.75-1.3-2.35-1.37V4h-1.5Z"
    ></path></svg
  >
  <span
    ><strong>Static data</strong> · {snapshot.symbol} as of {snapshot.asOfLabel}{detail ? ` · ${detail}` : ''}. Prices
    have moved since; the lesson holds.</span
  >
</p>

<style>
  .snap {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sl-color-gray-3);
  }
  svg {
    flex: none;
    margin-top: 0.12rem;
  }
</style>
